{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"/ABSOLUTE/PATH/TO/hikaru-memory/scripts/hikaru\" _tomonari_koe --prompt 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"/ABSOLUTE/PATH/TO/hikaru-memory/scripts/hikaru\" _tomonari_koe --after-tool 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
